<odoo>

    <record id="view_res_config_settings_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='pos_iface_big_scrollbars']/../.."
                position="before"
            >
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane" />
                    <div class="o_setting_right_pane">
                        <div class="text-muted">
                            Coma-separated list of fields that will be used to order the display of products.
                        </div>
                        <div class="content-group mt16">
                            <div>
                                <label
                                    for="pos_iface_product_order"
                                    class="col-lg-2 o_light_label"
                                />
                                <field
                                    name="pos_iface_product_order"
                                    placeholder="default_code,name"
                                />
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
